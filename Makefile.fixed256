# ============================================================================
# Makefile.fixed256 — benchmark every array config with the SAME 256KB SRAM.
#
#   make -f Makefile.fixed256                 # run everything
#   make -f Makefile.fixed256 JOBS=8          # set parallelism
#   make -f Makefile.fixed256 list            # preview what would run
#   make -f Makefile.fixed256 clean-batch     # delete all results
#
# Purpose: pin the SRAM capacity to a constant so that differences between
# configs come from the array architecture alone, not from SRAM size (this is
# why the capacity sweep was removed). The CACTI SRAM library is itself 256KB
# only, so capacity is no longer a free axis anyway.
#
# ---------------------------------------------------------------------------
# Why optimizer and not sim (important)
#
# Fixing the capacity still leaves one free variable: cd
# (contractingDimensionSize). cd is not K but the free/streaming tile length
# (ReuseB -> cd = tileM), and it is coupled to SRAM capacity: its upper bound is
# min(streamDim, faceCap / rowBytes) (ContractingDimension.hpp). The old "SRAM
# capacity sweep" was therefore implicitly also a cd sweep; fixing capacity
# and stopping there would also pin cd to a single point.
#
# sim (main.cpp), however, uses cd **at that upper bound** unless the .cfg sets
# it manually. The upper bound is not optimal: in ReuseB RMW,
# psumTile = cd * tileN * psumBytes grows linearly with cd, so fewer partial-sum
# tiles fit in an output face and the n-blocking factor nb is starved. An
# earlier measurement: going from input cap128 to cap256 raised cd 2048->4096,
# dropped nb 4->2 and increased DRAM reads 1.83x. Running sim would thus
# measure each config at a known sub-optimal point.
#
# On top of that, rowBytes = min(systolicArrayRowDimension, dimK) * bpe, so
# the cd upper bound differs per array config. Even with equal capacity every
# config would come with a different cd, confounding the comparison.
#
# So we use optimizer but kill the capacity axis:
#   OPT_CAP_MIN = OPT_CAP_MAX = CAP -> one 256KB candidate per role -> 1 SRAM combo.
#   The cd axis stays alive: Optimizer::cdCandidates sweeps a power-of-two
#   ladder down from the upper bound, and for each (config, layer) the best cd
#   under OBJECTIVE is picked and reported.
# Each config is thereby compared at "the best it can do with the same 256KB SRAM".
#
# Bandwidth is still automatic: candidates are guarded to the proper bandwidth
# derived from the array config (Optimizer::loadSrams). It is "same capacity,
# config-appropriate bandwidth", not "the same SRAM file".
#
# ---------------------------------------------------------------------------
# Incremental runs: each (config, layer) output is an independent make target.
# Up-to-date outputs are skipped, so an interrupted batch can be resumed. An
# output is rebuilt when any of these change:
#   - its array config .cfg / layer .cfg
#   - the optimizer binary
#   - the files in the SRAM input directory (.sram-stamp)
#   - the run parameters (CAP/OBJECTIVE/TOPK/CD_FULL/... -> .params)
# The last one matters most: results produced with different parameters would
# otherwise mix silently in one directory. If .params changes, everything reruns.
#
# Atomic writes: results go to <out>.tmp and are mv'd into place once the run
# finishes. A run killed midway never leaves a truncated output that looks
# "done" (a prerequisite for incremental runs).
#
# Failure caching: optimizer exits 2 = "no feasible combination" and 1 = input
# error; both are deterministic, so failing results are kept as outputs and not
# retried. To force a retry, delete the file or run clean-batch.
# ============================================================================

# Recipes use bash features ($(...) substitution etc.), so run them with bash, not sh.
SHELL := /bin/bash

# Used to invoke this Makefile recursively (to pass JOBS as -j).
THIS_MK := $(firstword $(MAKEFILE_LIST))

# Default goal for a bare `make -f Makefile.fixed256`. This MUST be explicit:
# make picks "the first target in the file" as default, and the .sram-stamp rule
# and the per-(config, layer) output rules generated by $(eval) below all come
# before `all:`. Without this, the default goal would be .sram-stamp, and a
# bare run would just touch the stamp and "succeed" with zero runs.
.DEFAULT_GOAL := all

# ===== Parallelism =====
# Every (config, layer) run is independent, so JOBS of them run concurrently.
#
# Note: nproc counts SMT threads (e.g. 8 physical cores -> 16). Measured
# throughput does not improve beyond the physical core count; only per-run
# latency grows. On SMT machines, lowering JOBS to the physical core count is
# better. Physical core count:
#   lscpu -p=Core,Socket | grep -v '^#' | sort -u | wc -l
JOBS ?= $(shell nproc)

# ===== Build =====
# optimizer binary and the main Makefile that knows how to build it.
OPT_BIN := optimizer
MAIN_MK := Makefile

# ===== Input directories =====
CONFIG_DIR := array_config
LAYER_DIR  := layer
SRAM_DIR   := cacti_results

# ===== Fixed SRAM capacity (KB) =====
# The reason this Makefile exists. All three roles (input/weight/output) are
# pinned to this value; min = max, so there is exactly one SRAM combination
# (no sweep).
#
# CAP only sets the OPT_CAP_MIN/MAX guard. The current CACTI library is
# 256KB-only, so any other value filters out every SRAM and all runs fail.
# OUT_DIR follows CAP, so results from a different (e.g. regenerated) library
# at another capacity would not mix with these:
#   make -f Makefile.fixed256 CAP=512
CAP ?= 256

# ===== Optimizer objective =====
#   energy | cycles | edp | tops
# Decides which cd is "best" for each (config, layer).
OBJECTIVE ?= tops

# ===== Uniform output-SRAM access width (bits) =====
# 0 = default rule (output row width = array output port width). >0 raises the
# output access width of every config to max(port width, this value)
# (coalescing experiment, see SramSelector.hpp). The widest row in the normal
# library is 8192, so only values up to that are valid.
OUT_ACCESS_BITS ?= 0

# ===== cd sweep range =====
# 0 = unbounded (the full ladder from the natural minimum up to the upper
# bound). Narrow it when short on time:
#   make -f Makefile.fixed256 CD_MIN=64 CD_MAX=2048
CD_MIN ?= 0
CD_MAX ?= 0

# ===== cd early stop =====
# The optimizer assumes the cd axis is unimodal and stops early
# (Optimizer::evaluate). The condition is conservative: it stops only when two
# signals agree after halving cd — (a) the score got worse AND (b) DRAM traffic
# did not drop. The only gain from a smaller cd is nb headroom (= less DRAM),
# which has already saturated, while the loss (utilization -> cycles/array
# energy) is monotonic in cd.
#
# CD_FULL=1 disables this assumption and simulates the whole range. The cd
# ladder is descending and smaller cd means many more tiles (slower runs), so
# CD_FULL=1 adds exactly the most expensive end.
#
# Why the default is 0 (early stop) — CD_FULL 1 vs 0 measured on 9 (config, layer) pairs:
#   the chosen cd and objective value were identical in 9/9. Runtime was equal
#   or up to 2x faster (llama prefill/ffn_fc1 x A3_ReuseB_64x64: 9.7s->5.0s,
#   Qwen prefill/q_proj x A2_ReuseB_4x8x4x4x8: 22.0s->19.8s).
#   The documented non-unimodal case openvla prefill/05_ffn_fc1 (from the old
#   Makefile.exp_cd notes: cycles reverse at cd=128) also gave cd=288 both
#   ways — because the condition needs both signals, a bump that small does
#   not trigger a stop.
# Still, 9 pairs are only a sample of the full batch. When adding a new
# geometry/dataflow or when results look suspicious, cross-check with CD_FULL=1
# (the report's `early-stop=N` tells how many sweeps were cut short).
CD_FULL ?= 0

# ===== DRAM energy backend / top-K refine =====
# Default is analytic-only (TOPK=0): candidates are ranked with the analytic
# DRAM model only and DRAMsim3 never runs (fast and self-contained).
#   TOPK=N>0 : analytic ranking + DRAMsim3 refine of the top N (two stages,
#              measured values replace the analytic ones).
# Note: with a single SRAM combination here, "top K" effectively means the top K
# cd candidates.
TOPK ?= 0
# OPT_DRAMSIM=0 when TOPK=0 (skip DRAMsim3 entirely), otherwise 1.
OPT_DRAMSIM := $(if $(filter 0,$(TOPK)),0,1)

# ===== Output =====
OUT_DIR ?= batch_fixed$(CAP)_results

# ===== What to run =====
# Every array_config/*.cfg, except test_* (small development configs).
CONFIGS := $(sort $(filter-out $(CONFIG_DIR)/test_%,$(wildcard $(CONFIG_DIR)/*.cfg)))

# Benchmark layers: layer/<model>/<phase>/<layer>.cfg (depth 3).
# Scratch files at the top of layer/ (e.g. test_16x16x16.cfg) are excluded.
LAYERS := $(shell find $(LAYER_DIR) -mindepth 3 -name '*.cfg' | sort)

# Stop immediately if no inputs are found. Otherwise zero rules would be
# generated and the batch would "succeed" with "=== done: 0 files ===", hiding
# a typo or a wrong CWD.
# (clean-batch / list are diagnostic, so only the run goals are checked.)
RUN_GOALS := all run-all opt-targets
ifneq ($(filter $(RUN_GOALS),$(or $(MAKECMDGOALS),all)),)
ifeq ($(strip $(CONFIGS)),)
$(error no array config .cfg found in $(CONFIG_DIR)/)
endif
ifeq ($(strip $(LAYERS)),)
$(error no benchmark layer .cfg found under $(LAYER_DIR)/ (depth 3))
endif
# Without the CACTI results root (normal CSV) every run fails the same way.
# Stop here instead of finding out after thousands of failed runs. (All CACTI
# sources are fixed at 256KB, so CAP only remains to set the OPT_CAP_MIN/MAX
# guard to 256.)
ifeq ($(strip $(wildcard $(SRAM_DIR)/normal/normal_results.csv)),)
$(error CACTI results not found in $(SRAM_DIR)/ (normal/normal_results.csv))
endif
endif

# CACTI result files in the SRAM library. Track the files, not the directories:
# a directory's mtime does not change when a file inside it is updated.
SRAM_FILES := $(wildcard $(SRAM_DIR)/*/*.csv)

# ---------------------------------------------------------------------------
# Output path rule: <OUT_DIR>/<config name>/<model_phase_layer>.txt
#   $(call out_path,<config.cfg>,<layer.cfg>)
# The report only goes to stdout, so it is saved to one file per combination.
# ---------------------------------------------------------------------------
out_path = $(OUT_DIR)/$(basename $(notdir $(1)))/$(subst /,_,$(basename $(patsubst $(LAYER_DIR)/%,%,$(2)))).txt

# ---------------------------------------------------------------------------
# Parameter signature (.params) / SRAM stamp (.sram-stamp)
#
# .params is rewritten ONLY when its content changes, so its mtime moves only
# on a real change and a rerun with unchanged parameters does not trigger a
# full recompute. (This is done with $(shell) at parse time rather than as a
# make rule, so there is no race under -j.)
# ---------------------------------------------------------------------------
OPT_SIG := CAP=$(CAP) OBJECTIVE=$(OBJECTIVE) TOPK=$(TOPK) CD_MIN=$(CD_MIN) CD_MAX=$(CD_MAX) CD_FULL=$(CD_FULL) SRAM_DIR=$(SRAM_DIR) OUT_ACCESS_BITS=$(OUT_ACCESS_BITS)
OPT_PARAMS := $(OUT_DIR)/.params
OPT_STAMP  := $(OUT_DIR)/.sram-stamp

# Measured runtime log (input to LPT ordering). One "<seconds>\t<target>" line
# is appended per run; if a target appears several times, the last (most
# recent) value wins.
OPT_COSTS := $(OUT_DIR)/.costs

# Create OUT_DIR and update .params only if the signature differs.
$(shell mkdir -p $(OUT_DIR); \
        [ "$$(cat $(OPT_PARAMS) 2>/dev/null)" = '$(OPT_SIG)' ] || printf '%s\n' '$(OPT_SIG)' > $(OPT_PARAMS))

# Touched whenever any SRAM library CSV is newer, invalidating all outputs.
$(OPT_STAMP): $(SRAM_FILES)
	@mkdir -p $(@D) && touch $@

# ---------------------------------------------------------------------------
# LPT (longest-processing-time-first) ordering
#
# Measured (config, layer) costs span 0.3 s to 650 s, more than 2000x. Starting
# the heavy ones first avoids ending with a single huge job while other cores
# sit idle.
#
# A static metric (M*N*K) does not work — measured runtimes were actually
# anti-correlated with it. E.g. llama decode/lm_head has MNK=131M but takes
# 650 s, while Qwen prefill/out_proj has MNK=420G (3200x) and takes 15.6 s:
# M=1 decode layers leave the array idle while the op count explodes. So targets
# are sorted by the measured runtime of previous runs (.costs), and targets with
# no record (= never completed) go first (cost 1e9).
#
# The target list MUST be passed as a file. Passing thousands of paths on a
# shell command line exceeds bash -c's single-argument limit (128KB); $(shell)
# then silently returns empty, opt-targets gets no prerequisites, and the whole
# batch becomes a no-op.
#   $(call lpt_order,<target list file>,<costs file>)
# ---------------------------------------------------------------------------
lpt_order = $(shell awk -v cf='$(2)' ' \
    BEGIN { while ((getline line < cf) > 0) { split(line, a, "\t"); cost[a[2]] = a[1] } } \
    { printf "%s\t%s\n", (($$0 in cost) ? cost[$$0] : 1e9), $$0 } ' '$(1)' \
  | sort -s -rn -k1,1 | cut -f2)

# Write a space-separated list to a file, one item per line, via $(file >)
# (bypasses the shell, so there is no length limit).
#   $(call write_list,<file>,<list>)
empty :=
space := $(empty) $(empty)
define newline


endef
write_list = $(file >$(1),$(subst $(space),$(newline),$(2)))

# ---------------------------------------------------------------------------
# Recipe body. It reads the target-specific variables ARR_CFG / LYR_CFG.
# Keeping the generated rule text small keeps parsing of thousands of rules fast.
#
# Each run gets a private TMPDIR (removed afterwards), prints a progress
# line, writes to <out>.tmp, reports failures without aborting the batch,
# moves the result into place and appends its wall time to .costs.
#
# Argument order: arrayConfig layer sramDir objective (no capacity arguments —
# the optimizer filters candidates with OPT_CAP_MIN/MAX). Burst vs. normal is
# decided by the arrayConfig kind, so ToroidalDual configs use the same command line.
# ---------------------------------------------------------------------------
define OPT_RECIPE
@mkdir -p $(@D); \
 work=$$(mktemp -d); start=$$(date +%s.%N); \
 printf '%-40s %s\n' "$(basename $(notdir $(ARR_CFG)))" "$(patsubst $(LAYER_DIR)/%,%,$(LYR_CFG))"; \
 if OPT_TOPK=$(TOPK) OPT_DRAMSIM=$(OPT_DRAMSIM) \
      OPT_CAP_MIN=$(CAP) OPT_CAP_MAX=$(CAP) \
      OPT_CD_MIN=$(CD_MIN) OPT_CD_MAX=$(CD_MAX) OPT_CD_FULL=$(CD_FULL) \
      OPT_OUT_ACCESS_BITS=$(OUT_ACCESS_BITS) \
      TMPDIR="$$work" ./$(OPT_BIN) "$(ARR_CFG)" "$(LYR_CFG)" $(SRAM_DIR) $(OBJECTIVE) > "$@.tmp" 2>&1; \
 then :; else echo "    FAILED/infeasible: $@"; fi; \
 end=$$(date +%s.%N); \
 mv -f "$@.tmp" "$@"; \
 printf '%s\t%s\n' "$$(echo "$$end - $$start" | bc)" "$@" >> $(OPT_COSTS); \
 rm -rf "$$work"
endef

# Rule template for one output. $(1)=config.cfg, $(2)=layer.cfg
define OPT_RULE
$(call out_path,$(1),$(2)): ARR_CFG := $(1)
$(call out_path,$(1),$(2)): LYR_CFG := $(2)
$(call out_path,$(1),$(2)): $(1) $(2) $(OPT_BIN) $(OPT_PARAMS) $(OPT_STAMP)
	$$(OPT_RECIPE)
endef

# All output files (configs x layers).
OPT_OUTS := $(foreach c,$(CONFIGS),$(foreach l,$(LAYERS),$(call out_path,$(c),$(l))))

# Target list file (input to LPT ordering).
OPT_LIST := $(OUT_DIR)/.targets
$(call write_list,$(OPT_LIST),$(OPT_OUTS))

# Instantiate one rule per (config, layer).
$(foreach c,$(CONFIGS),$(foreach l,$(LAYERS),$(eval $(call OPT_RULE,$(c),$(l)))))

.PHONY: all run-all opt-targets list clean-batch clean-costs

all: run-all

# Preview what would run.
list:
	@echo "CAP: $(CAP)KB fixed (input=weight=output, 1 SRAM combination)"
	@echo "cd:  swept per (config, layer)  [CD_MIN=$(CD_MIN) CD_MAX=$(CD_MAX) CD_FULL=$(CD_FULL)]"
	@echo "OBJECTIVE=$(OBJECTIVE)  TOPK=$(TOPK)"
	@echo "Configs ($(words $(CONFIGS))):"
	@for c in $(CONFIGS); do echo "  $$c"; done
	@echo "Layers ($(words $(LAYERS))):"
	@for l in $(LAYERS); do echo "  $$l"; done
	@echo "Total runs: $$(( $(words $(CONFIGS)) * $(words $(LAYERS)) ))"

# Build optimizer with the rule from the main Makefile.
#
# FORCE makes the sub-make run every time. Without a prerequisite, make would
# consider the binary up to date merely because the file exists, skip the
# recipe, and run the whole batch with a stale binary after source edits (only
# MAIN_MK knows the source dependencies). The sub-make updates the binary's
# mtime only when it actually recompiles, so unchanged sources do not cause
# outputs to rerun.
$(OPT_BIN): FORCE
	@$(MAKE) -f $(MAIN_MK) $@

FORCE:

# Build optimizer, drop stale *.txt.tmp leftovers from interrupted runs, then
# invoke this Makefile recursively to pass JOBS as -j (keeps the JOBS= interface).
run-all: $(OPT_BIN)
	@echo "=== batch: $(words $(CONFIGS)) configs x $(words $(LAYERS)) layers = $(words $(OPT_OUTS)) runs ==="
	@echo "=== CAP=$(CAP)KB fixed, cd swept (CD_FULL=$(CD_FULL)), objective=$(OBJECTIVE), TOPK=$(TOPK), JOBS=$(JOBS) ==="
	@echo "=== up-to-date outputs are skipped. Run clean-batch to rerun everything ==="
	@find $(OUT_DIR) -name '*.txt.tmp' -delete 2>/dev/null || true
	@$(MAKE) --no-print-directory -f $(THIS_MK) -j $(JOBS) opt-targets
	@echo "=== done: outputs in $(OUT_DIR)/ ($$(find $(OUT_DIR) -name '*.txt' | wc -l) files) ==="

# Internal goal: all outputs as prerequisites, in LPT order.
opt-targets: $(call lpt_order,$(OPT_LIST),$(OPT_COSTS))

# Delete the whole output directory (results, .params, .costs, .targets).
clean-batch:
	rm -rf $(OUT_DIR)

# Clear only the runtime log (results are kept), to reset the LPT ordering history.
clean-costs:
	rm -f $(OPT_COSTS)
